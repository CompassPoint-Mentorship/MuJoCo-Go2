# Settings for robo-dog.cpmentorship.org. Copy to .env (mode 600, never
# committed), fill in, then recreate the containers:
#   cd classroom && docker compose up -d --force-recreate
#   cd deploy/hub && docker compose up -d --force-recreate
# Quote any value with spaces or <...> so the file also loads in bash.
# docs/OPERATIONS.md explains each one.

# ---- the site ---------------------------------------------------------------
GO2_BASE_URL=https://robo-dog.cpmentorship.org
# Random, long, stable. Changing it signs everyone out.
GO2_SESSION_SECRET=
# Mentors' Google addresses, comma-separated: the root of the mentor list.
GO2_TEACHERS=
# The nginx gateway's address; X-Forwarded-* is believed only from it.
GO2_TRUSTED_PROXY=
# The class's own course pack (seeded from go2/course_pack on first use).
GO2_COURSE_PACK=/srv/MuJoCo-Go2/courses/live

# ---- Google sign-in (Google Cloud -> Google Auth Platform -> Clients) -------
# Redirect URI registered there: <GO2_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- email: everything is sent from this mailbox ----------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# A Google app password for SMTP_USER (myaccount.google.com/apppasswords).
SMTP_PASSWORD=
MAIL_FROM="Robo Dog - CompassPoint Mentorship <sender@example.org>"
# Optional: MAIL_DAILY_LIMIT=300, INBOX_EVERY=180 (seconds between reply checks)

# ---- online labs (JupyterHub) -----------------------------------------------
# Shared by the site and the hub: signs the pass into a student's lab.
GO2_HUB_SECRET=
# The console's key to JupyterHub's API (list and stop labs only). Shared too.
GO2_HUB_API_TOKEN=
# 1 once the gateway routes /labs/ to the hub: students see "Open my online lab".
GO2_HUB_PUBLIC=0

# ---- people -----------------------------------------------------------------
# For `gh`: a fine-grained PAT whose resource owner is the organisation.
GITHUB_ISSUE_TOKEN=
