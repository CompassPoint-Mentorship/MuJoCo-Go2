__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
# Student scratch output: images and recordings a notebook drops beside the
# work that made them (03_camera.py writes dog_view.png, for one). Pasted
# screenshots land here too, which is why .jpg is on the list -- without it
# a stray paste in the repo root is one `git add -A` from being committed.
#
# Images that belong to the PROJECT are named back in below. Order matters:
# a later rule wins, so every exception has to come after the blanket.
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.npy

# The vendored Go2 model's own textures.
!go2/assets/**/*.png
# The site's own assets: CompassPoint's logo and icons. Ignoring images by
# default once kept them out of git entirely -- the live site looked right
# because the files were on its disk, and every clone and CI run lacked them.
!classroom/static/**/*.png
!classroom/static/**/*.webp
!classroom/static/**/*.jpg

# Documentation images are written, not generated, so they are tracked.
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp
MUJOCO_LOG.TXT

# Hosted mode: per-student tokens/ports and their work directories
deploy/students/
student-work/

# Self-signed TLS for the student labs: machine-specific, regenerate with
# deploy/make-cert.sh
deploy/tls/

# Built by install/make-zip.sh; attach it to a release rather than commit it.
install/Go2-Lab-macOS.zip
# Written by the installer on the machine it installs to.
go2/_build.py

# Local secrets: the GitHub token used to file issues. Never commit.
.env

# The classroom site keeps its roster next to it; it is not source.
classroom/*.db
classroom/*.db-journal

# Downloaded OAuth client files are secrets; they belong in .env, not here.
client_secret_*.json

# The class's live course pack: content a mentor edits at runtime,
# seeded from go2/course_pack. Not source, and not the same on two
# deployments.
courses/

# Homework handed in from laptops: student data, not source.
handins/

# JupyterHub state: its database and cookie secret.
deploy/hub/data/
