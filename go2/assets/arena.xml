<!--
  Default student arena: flat floor, a few obstacles, and a chase camera.
  The robot itself comes from the vendored Menagerie model (BSD-3, Unitree).

  Obstacle geoms are all named obs_*; Go2.camera()/collision logic treats any
  contact that is NOT with "floor" as a blocking obstacle.
-->
<mujoco model="go2 arena">
  <!-- go2.xml and assets/ are vendored from MuJoCo Menagerie (BSD-3, Unitree);
       see LICENSE and UPSTREAM_README.md. They sit beside this file because
       go2.xml declares meshdir="assets" relative to the top-level model. -->
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="obstacle" rgba="0.85 0.35 0.2 1"/>
    <material name="goal"     rgba="0.2 0.7 0.3 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Chase camera: follows the robot without being attached to it. -->
    <camera name="chase" mode="trackcom" pos="-2.2 -1.6 1.3" xyaxes="0.6 -0.8 0  0.3 0.25 0.9"/>

    <!-- Obstacles. Rename/move/add freely when writing assignments. -->
    <geom name="obs_box_a"  type="box"      pos=" 2.0  0.6 0.25" size="0.25 0.25 0.25" material="obstacle"/>
    <geom name="obs_box_b"  type="box"      pos=" 2.6 -0.9 0.25" size="0.25 0.25 0.25" material="obstacle"/>
    <geom name="obs_pillar" type="cylinder" pos="-1.5  1.4 0.40" size="0.20 0.40"      material="obstacle"/>
    <geom name="obs_wall"   type="box"      pos=" 0.0  3.0 0.30" size="2.00 0.10 0.30" material="obstacle"/>

    <!-- A visual target; it is a site, so it never blocks the robot. -->
    <site name="goal" type="cylinder" pos="3.5 0 0.005" size="0.35 0.005" material="goal"/>
  </worldbody>

  <!-- No <keyframe> here on purpose: unitree_go2/go2.xml already defines "home",
       and MuJoCo rejects duplicate keyframe names. -->
</mujoco>
